<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Studio.CrashHandler</AssemblyName>
    <RootNamespace>Studio.CrashHandler</RootNamespace>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Studio.CrashHandler.Core\Studio.CrashHandler.Core.csproj" />
  </ItemGroup>
  <Target Name="KeepCrashHandlerLibrariesExternal" BeforeTargets="PrepareForBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
        Condition="'%(Filename)' == 'Studio.CrashHandler.Core' Or '%(Filename)' == 'Studio.CrashHandler.Diagnostics'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
