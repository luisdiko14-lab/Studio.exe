<Window x:Class="StudioSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Studio.exe Setup" Width="900" Height="570"
        MinWidth="900" MinHeight="570" MaxWidth="900" MaxHeight="570"
        WindowStartupLocation="CenterScreen" Background="#0B1020"
        Foreground="#E8EDF7" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111B2E">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#2563EB">
                        <TextBlock Text="S" FontSize="27" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STUDIO.EXE" FontSize="16" FontWeight="Bold"
                                   Foreground="#F8FAFC"/>
                        <TextBlock Text="DEVELOPMENT STUDIO" FontSize="9"
                                   Foreground="#8294B3" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Your workspace." FontSize="26" FontWeight="SemiBold"
                               TextWrapping="Wrap" Foreground="#F8FAFC"/>
                    <TextBlock Text="One place to write code, build projects, debug, and create 3D scenes."
                               Margin="0,14,0,0" FontSize="13" LineHeight="21"
                               Foreground="#A8B6CC" TextWrapping="Wrap"/>
                    <Border Background="#182842" CornerRadius="10" Padding="14" Margin="0,26,0,0">
                        <StackPanel>
                            <TextBlock Text="INSTALLER" FontSize="10" FontWeight="Bold"
                                       Foreground="#7FA9FF"/>
                            <TextBlock Text="Downloads the latest release and safely extracts the app files."
                                       Margin="0,8,0,0" FontSize="12" LineHeight="19"
                                       Foreground="#C0CCDE" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Windows 10 / 11  •  x64"
                           FontSize="11" Foreground="#71829D"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="42,38,42,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Install Studio.exe" FontSize="27" FontWeight="SemiBold"
                           Foreground="#F8FAFC"/>
                <TextBlock Text="Choose where Studio should be installed. The installer will download the latest release."
                           Margin="0,8,0,0" FontSize="13" Foreground="#94A3B8"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,34,0,0">
                <TextBlock Text="INSTALL LOCATION" FontSize="11" FontWeight="Bold"
                           Foreground="#91A4C2"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" Height="43"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse"
                            Margin="10,0,0,0" Background="#1D2A40" BorderBrush="#354761"
                            Click="BrowseButton_Click"/>
                </Grid>

                <TextBlock Text="OPTIONS" FontSize="11" FontWeight="Bold"
                           Foreground="#91A4C2" Margin="0,28,0,4"/>
                <CheckBox x:Name="StartMenuCheckBox" Content="Create a Start Menu shortcut"
                          IsChecked="True"/>
                <CheckBox x:Name="DesktopCheckBox" Content="Create a desktop shortcut"/>
                <CheckBox x:Name="LaunchCheckBox" Content="Launch Studio.exe when installation finishes"
                          IsChecked="True"/>

                <Border Background="#111B2B" CornerRadius="10" Padding="16" Margin="0,28,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="INSTALLATION PROGRESS" FontSize="10"
                                       FontWeight="Bold" Foreground="#8FA3C2"/>
                            <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Right"
                                       FontSize="11" Foreground="#B9C8DE"/>
                        </Grid>
                        <ProgressBar x:Name="InstallProgress" Height="7" Margin="0,12,0,10"
                                     Minimum="0" Maximum="100" Value="0"
                                     Background="#26344B" Foreground="#3B82F6"
                                     BorderThickness="0"/>
                        <TextBlock x:Name="StatusText" Text="Ready to install."
                                   FontSize="12" Foreground="#AAB8CC"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,25,0,0">
                <TextBlock Text="Studio.exe installer" VerticalAlignment="Center"
                           FontSize="11" Foreground="#71829D"/>
                <Button x:Name="InstallButton" Content="Install Studio.exe"
                        Width="190" HorizontalAlignment="Right"
                        Click="InstallButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
